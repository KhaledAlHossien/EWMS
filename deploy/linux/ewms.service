# خدمة EWMS على Linux (systemd) — انسخه إلى /etc/systemd/system/ewms.service
# ثم: sudo systemctl daemon-reload && sudo systemctl enable --now ewms
[Unit]
Description=EWMS - نظام إدارة سير العمل
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/ewms/app
ExecStart=/opt/ewms/app/API
User=ewms
Group=ewms
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=ewms

# الأسرار ونص الاتصال (ملف صلاحياته 600) — راجع ewms.env.example
EnvironmentFile=/etc/ewms/ewms.env
Environment=ASPNETCORE_ENVIRONMENT=Production
# يستمع على الجهاز نفسه فقط؛ Nginx أمامه
Environment=ASPNETCORE_URLS=http://127.0.0.1:5000
# مهم: تواريخ الإجازات («لا طلبات بأثر رجعي») والتذكيرات تعتمد على التوقيت المحلي للخادم
Environment=TZ=Asia/Damascus
Environment=DOTNET_NOLOGO=true

[Install]
WantedBy=multi-user.target
