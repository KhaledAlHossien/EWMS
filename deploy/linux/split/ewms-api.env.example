# إعدادات EWMS API للتثبيت المنفصل — انسخه إلى /etc/ewms/ewms-api.env ثم:
#   sudo chown root:ewms /etc/ewms/ewms-api.env && sudo chmod 640 /etc/ewms/ewms-api.env
# الأسماء بصيغة متغيرات البيئة في ASP.NET Core: «__» بدل «:».

# قاعدة البيانات على جهاز SQL Server المستقل (مستخدم SQL مخصص، لا sa).
# Encrypt=True هو الافتراضي في Microsoft.Data.SqlClient: إما شهادة على SQL Server موثوقة على هذا الجهاز،
# أو TrustServerCertificate=True داخل الشبكة الداخلية (الاتصال مشفّر لكن بلا تحقق من هوية الخادم).
ConnectionStrings__DefaultConnection=Server=SQL_VM_ADDRESS,1433;Database=EWMS;User Id=ewms_app;Password=CHANGE_ME;Encrypt=True;TrustServerCertificate=True

# مفتاح توقيع الجلسات (32 حرفاً على الأقل): openssl rand -base64 48
JwtSettings__Key=CHANGE_ME

# مفتاح تشفير كلمات سر الأجهزة (32 بايت Base64): openssl rand -base64 32
# ⚠ احفظ نسخة منه خارج الخادم: ضياعه يُضيّع كل كلمات سر الأجهزة المحفوظة.
DeviceInventory__PasswordKey=CHANGE_ME

# سقف حجم الملف الواحد في حقول «ملفات» بطبقات الخرائط (MB). client_max_body_size في Nginx أكبر منه بقليل.
MapLayers__MaxFileMegabytes=100

# مكان محتوى المرفقات: Database (الافتراضي) أو FileSystem = مجلد على الخادم (مشاركة SMB مركّبة — docs/DEPLOYMENT.md).
# مع FileSystem أضف RequiresMountsFor=/mnt/ewms-files إلى [Unit] في ewms-api.service.
FileStorage__Mode=Database
#FileStorage__Root=/mnt/ewms-files

# الترحيلات تُطبَّق تلقائياً عند الإقلاع (يحتاج مستخدم SQL صلاحية تعديل البنية: db_owner على قاعدة EWMS).
Database__MigrateOnStartup=true

# أول مدير نظام — لمرة واحدة: شغّل الخدمة، ادخل، ثم احذف السطرين وأعد التشغيل.
# كلمة المرور: 8 أحرف على الأقل، فيها حرف ورقم، ولا تساوي البريد.
Seed__AdminEmail=admin@example.local
Seed__AdminPassword=CHANGE_ME

# الحضور والانصراف (أجهزة البصمة على المنفذ 8081 — docs/DEPLOYMENT.md «الحضور والانصراف»). معطّل افتراضياً.
# مفتاح تشفير قوالب الوجه والإصبع: openssl rand -base64 32 — احفظ نسخة منه مع مفتاح كلمات سر الأجهزة.
#Attendance__Enabled=true
#Attendance__TemplateKey=CHANGE_ME
# مدة الاحتفاظ بصور لحظة البصم (يوم)، ومدة عدم الاتصال قبل إشعار الانقطاع (دقيقة)
#Attendance__PhotoRetentionDays=90
#Attendance__OfflineMinutes=10
