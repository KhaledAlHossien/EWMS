# خدمة الـ API لتثبيت EWMS المنفصل (الخادم والواجهة منفصلان) على Ubuntu 24.04 مع ASP.NET Core Runtime 10.
# انسخه إلى /etc/systemd/system/ewms-api.service ثم:
#   sudo systemctl daemon-reload && sudo systemctl enable --now ewms-api
[Unit]
Description=EWMS API - نظام إدارة سير العمل
After=network-online.target
Wants=network-online.target
# مع FileStorage__Mode=FileSystem على مشاركة SMB: لا تبدأ الخدمة قبل تركيبها (docs/DEPLOYMENT.md)
#RequiresMountsFor=/mnt/ewms-files

[Service]
WorkingDirectory=/opt/ewms/api
ExecStart=/usr/bin/dotnet /opt/ewms/api/API.dll
User=ewms
Group=ewms
Restart=always
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=30
SyslogIdentifier=ewms-api

# الإعدادات والأسرار ونص الاتصال (ملف صلاحياته 600) — انظر ewms-api.env.example
EnvironmentFile=/etc/ewms/ewms-api.env
Environment=ASPNETCORE_ENVIRONMENT=Production
# يستمع على الجهاز نفسه فقط؛ Nginx أمامه
Environment=ASPNETCORE_URLS=http://127.0.0.1:5000
# مهم: تواريخ الإجازات («لا طلبات بأثر رجعي») والتذكيرات تعتمد على التوقيت المحلي للخادم
Environment=TZ=Asia/Damascus
Environment=DOTNET_NOLOGO=true
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1

# تقوية بسيطة: لا كتابة إلا في مجلد التطبيق، ولا صلاحيات إضافية
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
