# /etc/ewms/ewms.env — إعدادات الإنتاج السرية. انسخه وعدّل القيم، ثم:
#   sudo chown root:root /etc/ewms/ewms.env && sudo chmod 600 /etc/ewms/ewms.env
# الخادم يرفض الإقلاع ويذكر الناقص إن بقيت قيمة غير صالحة (CHANGE_ME لا تجتاز الفحص).

# SQL Server (على الجهاز نفسه أو جهاز آخر). مستخدم SQL مخصص للتطبيق، لا sa.
ConnectionStrings__DefaultConnection=Server=127.0.0.1,1433;Database=EWMS;User Id=ewms_app;Password=CHANGE_ME;TrustServerCertificate=True;MultipleActiveResultSets=true

# مفتاح توقيع الجلسات:            openssl rand -base64 48
JwtSettings__Key=CHANGE_ME
# مفتاح تشفير كلمات سر الأجهزة:  openssl rand -base64 32
# ⚠ احفظ نسخة منه خارج الخادم: ضياعه يُضيّع كل كلمات سر الأجهزة المحفوظة.
DeviceInventory__PasswordKey=CHANGE_ME

# قسم العمليات الذي تتبع له طبقة الأجهزة في الخريطة (رقم القسم بعد إنشائه من صفحة الأقسام)
DeviceInventory__OwnerDepartmentId=1

# أول مدير نظام — لمرة واحدة: شغّل الخدمة، ثم احذف السطرين وأعد التشغيل، وغيّر كلمة المرور بعد أول دخول.
Seed__AdminEmail=admin@example.local
Seed__AdminPassword=CHANGE_ME
