<Project>
  <PropertyGroup>
    <!-- NU1900 = تعذّر جلب بيانات الثغرات من nuget.org (الجهاز بلا إنترنت). نافذة Package Manager Console
         تعامل هذا التحذير كخطأ فتوقف Update-Database. فحص الثغرات نفسه يبقى يعمل عند توفر الإنترنت (NU1901–NU1904). -->
    <NoWarn>$(NoWarn);NU1900</NoWarn>
    <!-- أي تحذير بناء يُفشل البناء (بوابة الجودة): الشيفرة الحالية بلا تحذيرات، فالقاعدة تحمي ما بعدها.
         وعند توفر الإنترنت (في CI) تُفشل ثغرة معروفة في حزمة البناء (NU1901–NU1904). -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NuGetAuditMode>all</NuGetAuditMode>
  </PropertyGroup>
</Project>
